# Public configuration: these values are available to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Server-only Supabase secret. Never use a NEXT_PUBLIC_ name for this key.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Legacy alternatives, if your project uses JWT API keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_JWT
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Retain this stable secret when upgrading; changing it breaks saved encrypted keys.
APP_ENCRYPTION_KEY=BASE64_ENCODED_32_RANDOM_BYTES

# Optional shared provider keys, server only. Defaults are selected in the database.
# Official YouTube, HikerAPI (Instagram), and LamaTok (TikTok).
YOUTUBE_API_KEY=
HIKERAPI_KEY=
LAMATOK_KEY=
# Optional fallbacks:
TIKHUB_KEY=
SCRAPECREATORS_KEY=

# Random secret of at least 32 characters. Vercel sends it as a Bearer token.
# Generate separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Scheduled refresh remains paused until enabled in /admin/providers.
# Set actual provider costs there; HikerAPI/LamaTok default to $0.02 per attempt.
# The hourly vercel.json schedule requires a supporting Vercel plan.
# No ADMIN_EMAILS or payment-provider variables are used in this release.
